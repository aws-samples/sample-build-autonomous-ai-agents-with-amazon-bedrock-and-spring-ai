# Copy to .env and source it (or export) before running locally.
# Twelve-factor config: every value is an environment override.

AWS_REGION=us-east-1
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_TEMPERATURE=0.3

# Create with scripts/create-memory.sh
AGENTCORE_MEMORY_ID=

MEMORY_EVENTS_LIMIT=100
RESPONSE_TIMEOUT=60s
INVOCATIONS_LIMIT=60
PING_LIMIT=240

# Set to "ecs" or "logstash" for structured JSON logs (recommended in the cloud)
LOG_FORMAT=

# Optional: AgentCore Gateway (MCP) endpoint
# GATEWAY_URL=
