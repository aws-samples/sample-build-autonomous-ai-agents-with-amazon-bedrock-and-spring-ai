# Base URL for the backend API. Leave empty to use the dev proxy / same origin.
VITE_API_BASE=
# "Return to home" link target (the landing page in code/landing-page). Build time.
VITE_LANDING_URL=http://localhost:3000/
# Used only by vite.config.ts dev proxy target (idp-agent backend runs on :8081 locally).
BACKEND_URL=http://localhost:8081
