# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates -> /etc/nginx/conf.d). Only variables defined in the
# environment are substituted, so nginx's own $uri / $host stay intact.
#   BACKEND_URL  Base URL of the idp-agent backend (default http://idp-agent:8080)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Uploads: the backend accepts files up to 15 MB and requests up to 20 MB
  # (spring.servlet.multipart.*). nginx defaults to 1 MB, so raise it to match.
  client_max_body_size 20m;

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Same-origin proxy to the backend, so the browser never needs CORS.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Document extraction can take a while on large PDFs.
    proxy_read_timeout 180s;
  }

  # Backend health (AgentCore /ping contract), so the landing page can show
  # backend status through this UI when the backend itself is not exposed.
  location = /ping {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $proxy_host;
  }

  # Liveness for the container and the load balancer.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Long-lived cache for hashed assets.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
}
