# Copy to .env and export before running locally. Twelve-factor: every value overridable.

AWS_REGION=us-east-1
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_TEMPERATURE=0.1

# Optional AgentCore Memory (leave empty to run without cross-document session memory)
AGENTCORE_MEMORY_ID=
MEMORY_LTM_AUTODISCOVERY=false
MEMORY_EVENTS_LIMIT=50

# Upload limits
MAX_FILE_SIZE=15MB
MAX_REQUEST_SIZE=20MB

# Rate limiting
INVOCATIONS_LIMIT=60
PING_LIMIT=240

# Set to "ecs" or "logstash" for structured JSON logs in the cloud
LOG_FORMAT=
